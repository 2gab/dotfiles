load {
    format = " %1min"
}
general {
    output_format = "i3bar"
    colors = true
    color_good = "#9FBE84"
    color_degraded = "#E8A93A"
    color_bad = "#C4405A"
    color_separator = "#675848"
    interval = "5"
}
battery 1 {
    format = " %status %percentage"
    format_down = "no battery"
    status_chr = ""
    status_bat = ""
    status_unk = ""
    status_full = ""
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 25
}
disk / {
    format = " %free"
}
tztime la {
    timezone = "America/Los_Angeles"
    format = "LA %H:%M:%S"
}
ethernet eth0 {
    format_up = "E: %ip"
    format_down = ""
}

run_watch VPN {
    pidfile = "/run/openvpn.pid"
    format = " VPN"
}

volume master {
        format = " %volume"
        format_muted = " muted"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

cpu_temperature 0 {
    path = "/sys/devices/platform/coretemp.0/temp1_input"
    format = "%degrees°C"
}

wireless wlp5s0 {
    format_up = " %ip"
    format_down = ""
}

run_watch DHCP {
    pidfile = "/run/dhcpcd-*.pid"
    format = "%title"
}

time {
    format = " %d/%m/%y %H:%M"
}

memory {
  format = " %used"
}

order += "disk /"
order += "run_watch VPN"
order += "wireless wlp5s0"
order += "battery 1"
order += "memory"
order += "load"
order += "volume master"
order += "time"
